# Copy to .env (local) or add as Colab Secrets. Never commit real keys.

# --- Observability (optional; without these, runs are logged to outputs/runs.jsonl only)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com      # or https://us.cloud.langfuse.com
RAG_USE_LANGFUSE=auto                              # auto | on | off

# --- Only needed for gated models (e.g. Gemma)
HF_TOKEN=

# --- Models
RAG_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
RAG_LLM_4BIT=false
RAG_EMBED_MODEL=BAAI/bge-base-en-v1.5
RAG_EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# --- Chunking / retrieval / generation
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60
RAG_RETRIEVAL_MODE=hybrid        # dense | bm25 | hybrid
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=3000
RAG_MAX_NEW_TOKENS=400
RAG_WORKDIR=/content/karamazov_rag
